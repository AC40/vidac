{
  "name": "vidac-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "uv run python scripts/dev.py",
    "dev:web": "npm run dev --workspace @vidac/web",
    "build": "npm run build --workspace @vidac/web",
    "check": "npm run check --workspace @vidac/web",
    "test": "uv run pytest",
    "test:browser": "playwright test",
    "format:web": "prettier --write apps/web/src apps/web/vite.config.ts tests/browser playwright.config.ts",
    "check:format": "prettier --check apps/web/src apps/web/vite.config.ts tests/browser playwright.config.ts",
    "start": "uv run vidac serve"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.8"
  }
}
